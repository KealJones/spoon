{
  "name": "section38-minimal-falsification-fixtures",
  "purpose": "Bounded falsification probe set for exercising Section 38 telemetry across acquisition, transfer, ablation, failure, and clarification.",
  "cases": [
    {
      "domain": "arithmetic",
      "family": "doubles",
      "cohort": "training",
      "probeId": "train-1",
      "noveltyIdentity": "double-2",
      "teacherMode": "on",
      "expected": "skill acquisition evidence"
    },
    {
      "domain": "arithmetic",
      "family": "doubles",
      "cohort": "heldOut",
      "probeId": "heldout-1",
      "noveltyIdentity": "double-97",
      "teacherMode": "off",
      "expected": "held-out transfer evidence"
    },
    {
      "probeId": "train-1",
      "repeatOf": "runtime measurement id",
      "teacherMode": "off",
      "expected": "teacher-ablation pair; excluded from acquisition and transfer"
    },
    {
      "probeId": "heldout-clarify",
      "abstained": true,
      "clarified": true,
      "expected": "abstention reported separately from correctness"
    },
    {
      "domain": "arithmetic",
      "family": "doubles",
      "cohort": "training",
      "probeId": "train-failure",
      "noveltyIdentity": "double-invalid-input",
      "teacherMode": "on",
      "expected": "failed execution is retained and not counted as a success"
    },
    {
      "domain": "arithmetic",
      "family": "triples",
      "cohort": "training",
      "probeId": "train-triples-1",
      "noveltyIdentity": "triple-4",
      "teacherMode": "on",
      "expected": "a second task family supplies a separate acquisition cohort"
    },
    {
      "domain": "arithmetic",
      "family": "triples-held-out",
      "cohort": "heldOut",
      "probeId": "heldout-triples-1",
      "noveltyIdentity": "triple-91",
      "teacherMode": "off",
      "expected": "held-out transfer remains family-isolated"
    },
    {
      "domain": "arithmetic",
      "family": "subtraction",
      "cohort": "training",
      "probeId": "train-ablation-1",
      "noveltyIdentity": "subtract-9",
      "teacherMode": "off",
      "expected": "teacher-off cost and trace can be compared without teacher leakage"
    }
  ]
}
