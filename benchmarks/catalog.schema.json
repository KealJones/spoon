{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoon.local/schemas/benchmark-catalog.schema.json",
  "title": "Spoon benchmark catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "purpose", "suites"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "purpose", "fixtures"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "fixtures": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
